  "settings": [
    {
      "name": "Linux keeps settings in the XDG config folder",
      "os": "linux",
      "input": {
        "home": "/home/ada",
        "xdg": ""
      },
      "expect": {
        "path": "/home/ada/.config/videoannotator/start.conf"
      }
    },
    {
      "name": "Linux follows XDG_CONFIG_HOME",
      "os": "linux",
      "input": {
        "home": "/home/ada",
        "xdg": "/home/ada/.cfg"
      },
      "expect": {
        "path": "/home/ada/.cfg/videoannotator/start.conf"
      }
    },
    {
      "name": "macOS keeps settings in Application Support",
      "os": "macos",
      "input": {
        "home": "/Users/ada",
        "xdg": ""
      },
      "expect": {
        "path": "/Users/ada/Library/Application Support/VideoAnnotator/start.conf"
      }
    },
    {
      "name": "Windows keeps settings in APPDATA",
      "os": "windows",
      "input": {
        "home": "C:\\Users\\ada",
        "appdata": "C:\\Users\\ada\\AppData\\Roaming"
      },
      "expect": {
        "path": "C:\\Users\\ada\\AppData\\Roaming\\VideoAnnotator\\start.conf"
      }
    }
  ],
  "run": [
    {
      "name": "Linux, Podman, one share (the contract's example)",
      "os": "linux",
      "input": {
        "engine": "podman",
        "home": "/home/ada",
        "shares": [
          "/home/ada/Studies"
        ],
        "missing": [],
        "results": "/home/ada/VideoAnnotator",
        "port": "18011",
        "image": "ghcr.io/infantlab/videoannotator:1.6.0",
        "uid": "1000",
        "gid": "1000",
        "gpu": "",
        "desktop": "no"
      },
      "expect": {
        "args": [
          "run",
          "-d",
          "--name",
          "videoannotator",
          "-p",
          "127.0.0.1:18011:18011",
          "-v",
          "videoannotator-models:/app/models",
          "-v",
          "videoannotator-database:/app/database",
          "-v",
          "videoannotator-storage:/app/storage",
          "-v",
          "videoannotator-cache:/app/cache",
          "--mount",
          "type=bind,source=/home/ada/Studies,target=/home/ada/Studies,readonly",
          "--mount",
          "type=bind,source=/home/ada/VideoAnnotator,target=/home/ada/VideoAnnotator",
          "--mount",
          "type=bind,source=/home/ada/.config/videoannotator/requests,target=/app/launcher/requests",
          "-e",
          "VIDEOANNOTATOR_INGEST_ROOTS=/home/ada/Studies",
          "-e",
          "VIDEOANNOTATOR_MISSING_SHARES=",
          "-e",
          "VIDEOANNOTATOR_RESULTS_DIR=/home/ada/VideoAnnotator",
          "-e",
          "VIDEOANNOTATOR_HOST_PATHS=/home/ada/Studies=/home/ada/Studies;/home/ada/VideoAnnotator=/home/ada/VideoAnnotator",
          "-e",
          "VIDEOANNOTATOR_PUBLISHED_LOCALLY=1",
          "-e",
          "VIDEOANNOTATOR_LAUNCHER=1",
          "ghcr.io/infantlab/videoannotator:1.6.0"
        ]
      }
    },
