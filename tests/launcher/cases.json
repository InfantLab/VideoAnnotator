{
  "//": "Expected launcher behaviour, shared by tests/launcher/*.bats (sh) and Launcher.Tests.ps1 (PowerShell). See launcher/README.md.",
  "paths": [
    {
      "name": "a home folder keeps its real path",
      "os": "any",
      "input": {
        "path": "/home/ada/Studies",
        "n": 1
      },
      "expect": {
        "container": "/home/ada/Studies"
      }
    },
    {
      "name": "a macOS folder keeps its real path",
      "os": "any",
      "input": {
        "path": "/Users/ada/Movies/Study",
        "n": 1
      },
      "expect": {
        "container": "/Users/ada/Movies/Study"
      }
    },
    {
      "name": "an external drive keeps its real path",
      "os": "any",
      "input": {
        "path": "/media/ada/Drive/Study",
        "n": 1
      },
      "expect": {
        "container": "/media/ada/Drive/Study"
      }
    },
    {
      "name": "a folder under an image folder goes under /host",
      "os": "any",
      "input": {
        "path": "/opt/data",
        "n": 1
      },
      "expect": {
        "container": "/host/opt/data"
      }
    },
    {
      "name": "/srv goes under /host",
      "os": "any",
      "input": {
        "path": "/srv/lab/videos",
        "n": 2
      },
      "expect": {
        "container": "/host/srv/lab/videos"
      }
    },
    {
      "name": "/tmp goes under /host",
      "os": "any",
      "input": {
        "path": "/tmp/videos",
        "n": 1
      },
      "expect": {
        "container": "/host/tmp/videos"
      }
    },
    {
      "name": "spaces kept",
      "os": "any",
      "input": {
        "path": "/home/ada/My Studies/Day 1",
        "n": 1
      },
      "expect": {
        "container": "/home/ada/My Studies/Day 1"
      }
    },
    {
      "name": "accents and non-Latin characters kept",
      "os": "any",
      "input": {
        "path": "/home/zoë/Études/研究",
        "n": 1
      },
      "expect": {
        "container": "/home/zoë/Études/研究"
      }
    },
    {
      "name": "a colon means a numbered mount",
      "os": "any",
      "input": {
        "path": "/home/ada/Study: 2024",
        "n": 1
      },
      "expect": {
        "container": "/host/1"
      }
    },
    {
      "name": "a comma means a numbered mount",
      "os": "any",
      "input": {
        "path": "/data/a,b",
        "n": 2
      },
      "expect": {
        "container": "/host/2"
      }
    },
    {
      "name": "an equals sign means a numbered mount",
      "os": "any",
      "input": {
        "path": "/data/x=y",
        "n": 3
      },
      "expect": {
        "container": "/host/3"
      }
    },
    {
      "name": "a semicolon means a numbered mount",
      "os": "any",
      "input": {
        "path": "/data/a;b",
        "n": 1
      },
      "expect": {
        "container": "/host/1"
      }
    },
    {
      "name": "results with a colon",
      "os": "any",
      "input": {
        "path": "/home/ada/Results: 2024",
        "n": "results"
      },
      "expect": {
        "container": "/host/results"
      }
    },
    {
      "name": "a Windows folder maps to its drive",
      "os": "windows",
      "input": {
        "path": "C:\\Users\\ada\\Studies",
        "n": 1
      },
      "expect": {
        "container": "/c/Users/ada/Studies"
      }
    },
    {
      "name": "a Windows drive letter is lower-cased",
      "os": "windows",
      "input": {
        "path": "E:\\Data",
        "n": 1
      },
      "expect": {
        "container": "/e/Data"
      }
    },
    {
      "name": "a Windows trailing separator is dropped",
      "os": "windows",
      "input": {
        "path": "D:\\Videos\\",
        "n": 1
      },
      "expect": {
        "container": "/d/Videos"
      }
    },
    {
      "name": "Windows spaces kept",
      "os": "windows",
      "input": {
        "path": "C:\\Users\\ada\\My Videos",
        "n": 1
      },
      "expect": {
        "container": "/c/Users/ada/My Videos"
      }
    },
    {
      "name": "a Windows comma means a numbered mount",
      "os": "windows",
      "input": {
        "path": "C:\\data\\a,b",
        "n": 2
      },
      "expect": {
        "container": "/host/2"
      }
    }
  ],
  "normalise": [
    {
      "name": "a trailing separator is dropped",
      "os": "any",
      "input": {
        "path": "/home/ada/Studies/",
        "home": "/home/ada"
      },
      "expect": {
        "path": "/home/ada/Studies"
      }
    },
    {
      "name": "several trailing separators",
      "os": "any",
      "input": {
        "path": "/home/ada/Studies//",
        "home": "/home/ada"
      },
      "expect": {
        "path": "/home/ada/Studies"
      }
    },
    {
      "name": "the root stays the root",
      "os": "any",
      "input": {
        "path": "/",
        "home": "/home/ada"
      },
      "expect": {
        "path": "/"
      }
    },
    {
      "name": "a tilde is the home folder",
      "os": "any",
      "input": {
        "path": "~/Studies",
        "home": "/home/ada"
      },
      "expect": {
        "path": "/home/ada/Studies"
      }
    },
    {
      "name": "doubled separators collapse",
      "os": "any",
      "input": {
        "path": "/home//ada/./Studies",
        "home": "/home/ada"
      },
      "expect": {
        "path": "/home/ada/Studies"
      }
    },
    {
      "name": "a Windows trailing separator is dropped",
      "os": "windows",
      "input": {
        "path": "C:\\Users\\ada\\Studies\\",
        "home": "C:\\Users\\ada"
      },
      "expect": {
        "path": "C:\\Users\\ada\\Studies"
      }
    },
    {
      "name": "a Windows drive root keeps its separator",
      "os": "windows",
      "input": {
        "path": "E:\\",
        "home": "C:\\Users\\ada"
      },
      "expect": {
        "path": "E:\\"
      }
    }
  ],
  "classify": [
