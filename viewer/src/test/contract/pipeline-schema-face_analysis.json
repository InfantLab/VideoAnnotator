{
  "pipeline": {
    "id": "face_analysis",
    "name": "Face Analysis (DeepFace)",
    "description": "Standards-only face detection and analysis using DeepFace with emotion recognition, age, and gender prediction, producing COCO format output.",
    "group": "face",
    "title": "Faces: expression, age, gender",
    "summary": "Finds faces in each sampled frame and estimates each face's expression, age and gender."
  },
  "parameters": [
    {
      "name": "detection_backend",
      "type": "string",
      "label": "Face detector",
      "description": "Face detection backend (opencv, deepface, ssd, dlib, mtcnn, retinaface)",
      "default": "deepface",
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    },
    {
      "name": "emotion_backend",
      "type": "string",
      "label": "Expression model",
      "description": "Emotion analysis backend (deepface, disabled)",
      "default": "deepface",
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    },
    {
      "name": "confidence_threshold",
      "type": "number",
      "label": "Detection confidence",
      "description": "Minimum confidence threshold for face detection",
      "default": 0.7,
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": 0.0,
      "max": 1.0,
      "applies_when": null
    },
    {
      "name": "min_face_size",
      "type": "integer",
      "label": "Smallest face",
      "description": "Minimum face size in pixels",
      "default": 30,
      "enum": null,
      "group": "behavioural",
      "unit": "px",
      "min": 1.0,
      "max": null,
      "applies_when": null
    },
    {
      "name": "max_faces",
      "type": "integer",
      "label": "Most faces per frame",
      "description": "Maximum number of faces to detect per frame",
      "default": 10,
      "enum": null,
      "group": "behavioural",
      "unit": "faces",
      "min": 1.0,
      "max": null,
      "applies_when": null
    },
    {
      "name": "scale_factor",
      "type": "number",
      "label": "Haar cascade scale factor",
      "description": "Scale factor for OpenCV Haar cascades",
      "default": 1.1,
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": {
        "detection_backend": [
          "opencv"
        ]
      }
    },
    {
      "name": "min_neighbors",
      "type": "integer",
      "label": "Haar cascade neighbours",
      "description": "Minimum neighbors for OpenCV Haar cascades",
      "default": 5,
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": {
        "detection_backend": [
          "opencv"
        ]
      }
    },
    {
      "name": "detect_emotions",
      "type": "boolean",
      "label": "Expression",
      "description": "Enable emotion recognition",
      "default": true,
      "enum": null,
      "group": "behavioural",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    },
    {
      "name": "detect_age",
      "type": "boolean",
      "label": "Age",
      "description": "Enable age estimation",
      "default": true,
      "enum": null,
      "group": "behavioural",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    },
    {
      "name": "detect_gender",
      "type": "boolean",
      "label": "Gender",
      "description": "Enable gender prediction",
      "default": true,
      "enum": null,
      "group": "behavioural",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
