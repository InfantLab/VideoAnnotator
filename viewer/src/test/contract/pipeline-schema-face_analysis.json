    {
      "name": "deepface",
      "type": "object",
      "label": "DeepFace models",
      "description": "DeepFace-specific configuration",
      "default": {
        "emotion_model": "VGG-Face",
        "age_gender_model": "VGG-Face",
        "detector_backend": "retinaface",
        "enforce_detection": false
      },
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    },
    {
      "name": "person_identity",
      "type": "object",
      "label": "Link faces to people",
      "description": "Person identity linking configuration",
      "default": {
        "enabled": true,
        "link_to_persons": true,
        "iou_threshold": 0.5,
        "require_person_id": false
      },
      "enum": null,
      "group": "technical",
      "unit": null,
      "min": null,
      "max": null,
      "applies_when": null
    }
  ]
